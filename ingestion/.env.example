# ── Gemini API ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gemini Model (optional, defaults to gemini-2.0-flash) ──────────────────
# GEMINI_MODEL=gemini-2.0-flash

# ── PDF Reader Preference (optional) ───────────────────────────────────────
# Comma-separated, tried left to right: docling, pymupdf, pdfplumber
# PDF_READER_PREFERENCE=docling,pymupdf,pdfplumber
